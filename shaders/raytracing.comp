#version 450 core

// Voxel Ray Tracing Compute Shader
// Traces rays through the voxel world for accurate lighting

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Output: lighting texture (R = direct light, G = sky visibility, B = bounce light, A = ambient occlusion)
layout(rgba16f, binding = 0) uniform image2D lightingOutput;

// Input textures
layout(binding = 1) uniform sampler2D depthTexture;
layout(binding = 2) uniform sampler2D normalTexture;  // Could be derived or passed
layout(binding = 3) uniform usampler3D voxelData;     // 3D voxel grid (block types)

// Uniforms
uniform mat4 invViewProj;
uniform vec3 cameraPos;
uniform vec3 lightDir;
uniform vec3 lightColor;
uniform ivec3 voxelGridSize;
uniform vec3 voxelGridOrigin;  // World position of voxel grid corner
uniform vec3 renderOrigin;     // Camera-relative rendering origin (to convert back to world)
uniform float voxelSize;       // Size of each voxel in world units
uniform int maxRaySteps;
uniform float rayMaxDistance;
uniform bool enableAO;         // Whether to compute AO (expensive)

// Constants
const float EPSILON = 0.001;
const int MAX_BOUNCES = 2;

// Get world position from depth buffer
// Note: invViewProj gives us camera-relative position, we need to add renderOrigin for true world pos
vec3 getWorldPos(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 relativePos = invViewProj * clipPos;
    vec3 cameraRelativePos = relativePos.xyz / relativePos.w;
    // Convert from camera-relative to actual world position
    return cameraRelativePos + renderOrigin;
}

// Convert world position to voxel grid coordinates
ivec3 worldToVoxel(vec3 worldPos) {
    vec3 localPos = (worldPos - voxelGridOrigin) / voxelSize;
    return ivec3(floor(localPos));
}

// Check if voxel coordinates are within grid bounds
bool isInGrid(ivec3 voxelPos) {
    return all(greaterThanEqual(voxelPos, ivec3(0))) && 
           all(lessThan(voxelPos, voxelGridSize));
}

// Get block type at voxel position (0 = air, >0 = solid)
uint getVoxel(ivec3 voxelPos) {
    if (!isInGrid(voxelPos)) return 0u;  // Outside grid = air
    return texelFetch(voxelData, voxelPos, 0).r;
}

// DDA Ray marching through voxel grid
// Returns true if ray hits a solid voxel before reaching maxDist
bool rayMarchVoxels(vec3 rayOrigin, vec3 rayDir, float maxDist, out float hitDist, out ivec3 hitVoxel, out vec3 hitNormal) {
    // Starting voxel
    ivec3 currentVoxel = worldToVoxel(rayOrigin);
    
    // Direction signs
    ivec3 step = ivec3(sign(rayDir));
    
    // Handle zero components
    vec3 safeDir = rayDir;
    safeDir.x = abs(safeDir.x) < EPSILON ? EPSILON : safeDir.x;
    safeDir.y = abs(safeDir.y) < EPSILON ? EPSILON : safeDir.y;
    safeDir.z = abs(safeDir.z) < EPSILON ? EPSILON : safeDir.z;
    
    // Distance to next voxel boundary along each axis
    vec3 voxelBoundary = vec3(currentVoxel) + vec3(max(step, ivec3(0)));
    vec3 tMax = ((voxelBoundary * voxelSize + voxelGridOrigin) - rayOrigin) / safeDir;
    
    // Distance to travel along ray to cross one voxel
    vec3 tDelta = abs(vec3(voxelSize) / safeDir);
    
    float distTraveled = 0.0;
    int stepsTaken = 0;
    
    while (stepsTaken < maxRaySteps && distTraveled < maxDist) {
        // Check current voxel
        if (isInGrid(currentVoxel)) {
            uint blockType = getVoxel(currentVoxel);
            if (blockType > 0u) {
                // Hit a solid block
                hitDist = distTraveled;
                hitVoxel = currentVoxel;
                return true;
            }
        }
        
        // Move to next voxel (DDA step)
        if (tMax.x < tMax.y) {
            if (tMax.x < tMax.z) {
                distTraveled = tMax.x;
                tMax.x += tDelta.x;
                currentVoxel.x += step.x;
                hitNormal = vec3(-float(step.x), 0.0, 0.0);
            } else {
                distTraveled = tMax.z;
                tMax.z += tDelta.z;
                currentVoxel.z += step.z;
                hitNormal = vec3(0.0, 0.0, -float(step.z));
            }
        } else {
            if (tMax.y < tMax.z) {
                distTraveled = tMax.y;
                tMax.y += tDelta.y;
                currentVoxel.y += step.y;
                hitNormal = vec3(0.0, -float(step.y), 0.0);
            } else {
                distTraveled = tMax.z;
                tMax.z += tDelta.z;
                currentVoxel.z += step.z;
                hitNormal = vec3(0.0, 0.0, -float(step.z));
            }
        }
        
        stepsTaken++;
    }
    
    hitDist = maxDist;
    return false;
}

// Trace shadow ray towards sun with soft shadows
float traceShadowRay(vec3 origin, vec3 lightDirection) {
    float hitDist;
    ivec3 hitVoxel;
    vec3 hitNormal;
    
    // Offset origin slightly to avoid self-intersection
    vec3 offsetOrigin = origin + lightDirection * voxelSize * 0.5;
    
    // Check if we're starting inside the grid
    ivec3 startVoxel = worldToVoxel(offsetOrigin);
    bool startedInGrid = isInGrid(startVoxel);
    
    // Trace the shadow ray
    if (rayMarchVoxels(offsetOrigin, lightDirection, rayMaxDistance, hitDist, hitVoxel, hitNormal)) {
        // Hit something - calculate soft shadow based on distance
        // Closer occluders = harder shadows, distant = softer
        float softness = smoothstep(0.0, 32.0, hitDist);
        return softness * 0.2;  // Allow some light through for soft shadows at distance
    }
    
    // If we started in grid and exited without hitting anything,
    // we need to check if we're going "upward" toward the light
    // If lightDir.y > 0 and we exited the top of the grid, assume lit
    // If we exited the sides, we can't be sure - use partial shadow
    if (startedInGrid) {
        // Check exit direction - if primarily upward and light is above, probably lit
        if (lightDirection.y > 0.3) {
            return 1.0;  // Light is coming from above, we're likely lit
        }
        // Light is more horizontal - we might be in shadow from distant terrain
        // Return partial shadow to blend with shadow map
        return 0.7;
    }
    
    return 1.0;  // No hit, fully lit
}

// Trace sky visibility ray (straight up) with multiple samples for better accuracy
float traceSkyRay(vec3 origin) {
    float hitDist;
    ivec3 hitVoxel;
    vec3 hitNormal;
    
    vec3 offsetOrigin = origin + vec3(0.0, voxelSize * 0.5, 0.0);
    
    // Primary ray straight up
    if (rayMarchVoxels(offsetOrigin, vec3(0.0, 1.0, 0.0), rayMaxDistance, hitDist, hitVoxel, hitNormal)) {
        // Under cover - calculate how deep we are
        float coverDepth = min(hitDist / 16.0, 1.0);
        return coverDepth * 0.3;  // Allow some ambient in caves based on depth
    }
    
    // Check if we exited the grid going up - if so, we can see sky
    ivec3 startVoxel = worldToVoxel(offsetOrigin);
    if (isInGrid(startVoxel)) {
        return 1.0;  // Started in grid, no hit going up = can see sky
    }
    
    return 0.8;  // Outside grid, assume mostly lit
}

// Simple ambient occlusion via short rays - OPTIMIZED
// Uses only 4 samples with fixed directions for performance and consistency
float traceAO(vec3 origin, vec3 normal) {
    float ao = 0.0;
    
    // Use fixed sample directions relative to normal for consistent results (no noise)
    // These are the 4 cardinal directions in the hemisphere
    vec3 tangent = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 bitangent = normalize(cross(normal, tangent));
    tangent = cross(bitangent, normal);
    
    // Fixed sample directions - no randomness = no noise
    vec3 sampleDirs[4];
    sampleDirs[0] = normalize(normal * 0.7 + tangent * 0.7);
    sampleDirs[1] = normalize(normal * 0.7 - tangent * 0.7);
    sampleDirs[2] = normalize(normal * 0.7 + bitangent * 0.7);
    sampleDirs[3] = normalize(normal * 0.7 - bitangent * 0.7);
    
    vec3 offsetOrigin = origin + normal * voxelSize * 0.5;
    float aoRadius = voxelSize * 3.0;  // Shorter range for performance
    
    for (int i = 0; i < 4; i++) {
        float hitDist;
        ivec3 hitVoxel;
        vec3 hitNormal;
        
        if (rayMarchVoxels(offsetOrigin, sampleDirs[i], aoRadius, hitDist, hitVoxel, hitNormal)) {
            // Softer falloff
            float occl = 1.0 - (hitDist / aoRadius);
            ao += occl * occl;  // Quadratic falloff for softer AO
        }
    }
    
    // Reduce AO strength - multiply by 0.5 for subtler effect
    float aoStrength = 0.5;
    return 1.0 - (ao / 4.0) * aoStrength;
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(lightingOutput);
    
    if (pixelCoord.x >= outputSize.x || pixelCoord.y >= outputSize.y) return;
    
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(outputSize);
    
    // Get depth and world position
    float depth = texelFetch(depthTexture, pixelCoord, 0).r;
    
    // Sky pixels - full light, no reflection data
    if (depth >= 0.9999) {
        imageStore(lightingOutput, pixelCoord, vec4(1.0, 0.0, 0.0, 1.0));
        return;
    }
    
    vec3 worldPos = getWorldPos(uv, depth);
    
    // Check if world position is inside voxel grid
    ivec3 voxelPos = worldToVoxel(worldPos);
    bool inGrid = isInGrid(voxelPos);
    
    // If outside grid, use default lighting (let shadow map handle it)
    if (!inGrid) {
        imageStore(lightingOutput, pixelCoord, vec4(1.0, 0.0, 0.0, 1.0));
        return;
    }
    
    // Trace shadow ray only - much faster!
    float directLight = traceShadowRay(worldPos, lightDir);
    
    // Output: R = direct light, GBA = reserved for future use (reflections, etc)
    vec4 lighting = vec4(directLight, 0.0, 0.0, 1.0);
    
    imageStore(lightingOutput, pixelCoord, lighting);
}
